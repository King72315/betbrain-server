# CourtEdge mobile app — API routing (LOCAL-first in development)

# Mode: auto | local | render
# - auto (dev): probe LOCAL, fall back to RENDER if unreachable
# - local: force LOCAL (clear error if down; no silent Render merge)
# - render: force RENDER (production default when mode unset)
EXPO_PUBLIC_API_MODE=auto

EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_RENDER_API_URL=https://betbrain-server-1.onrender.com

# Legacy compatibility (optional). Non-local values become the Render/remote target.
# EXPO_PUBLIC_API_URL=https://betbrain-server-1.onrender.com

# Physical phones cannot reach 127.0.0.1 on your laptop — use LAN IP for device-local:
# EXPO_PUBLIC_LOCAL_API_URL=http://192.168.1.100:3000
