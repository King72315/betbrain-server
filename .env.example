# CourtEdge mobile app — backend API base URL
#
# localhost works only in Android emulator / iOS simulator on the same machine.
# Physical phones cannot reach localhost — use one of the options below.
#
# Local dev on a phone (same Wi‑Fi as your PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# Hosted backend (Render, Railway, etc.):
# EXPO_PUBLIC_API_URL=https://your-betbrain-server.onrender.com
#
# For EAS Build APKs, set this in .env locally before `eas build`, or configure
# EAS environment variables / secrets so the URL is baked into the release build.

EXPO_PUBLIC_API_URL=http://localhost:3000
